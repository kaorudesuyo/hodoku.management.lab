# Netlify / Cloudflare Pages 用のレスポンスヘッダー設定
# （meta タグでは設定できない項目。Apache の場合は .htaccess を使用）
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'none'; base-uri 'none'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; script-src 'sha256-I850Sf3dwGqwUILMSTRueK0Tbntwoa3wpjV9ffdH9BQ='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src https://formsubmit.co; manifest-src 'self'; upgrade-insecure-requests
  Cache-Control: public, max-age=3600
